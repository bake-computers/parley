{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "ALCHEMY_SECRET_PASSPHRASE",
    "ALCHEMY_STAGE",
    "CLOUDFLARE_API_TOKEN",
    "CLOUDFLARE_ACCOUNT_ID",
    "PARLEY_WORKER_NAME",
    "LANDING_WORKER_NAME",
    "BRIDGE_WORKER_NAME",
    "AXIOM_TOKEN",
    "AXIOM_DATASET",
    "AXIOM_ORG_ID",
    "AXIOM_EDGE",
    "AXIOM_EDGE_URL",
    "AXIOM_ENABLED",
    "ENGINE_SERVICE_URL",
    "DISCORD_PUBLIC_KEY",
    "DISCORD_BOT_TOKEN",
    "DISCORD_APPLICATION_ID",
    "DISCORD_BOT_OWNER_ID",
    "BRIDGE_ALLOWED_ORIGINS",
    "BRIDGE_POLL_INTERVAL_MS"
  ],
  "globalDependencies": ["tsconfig.json", "alchemy.run.ts"],
  "tasks": {
    "//#alchemy:prepare": {
      "cache": true,
      "outputs": ["apps/landing/.alchemy/**"],
      "inputs": ["alchemy.run.ts", ".env*"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!**/*.test.ts", "!**/*.spec.ts"]
    },
    "landing#build": {
      "dependsOn": ["//#alchemy:prepare", "^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!**/*.test.ts", "!**/*.spec.ts"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["build"]
    },
    "//#dev": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
