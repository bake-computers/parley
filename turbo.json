{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    },
    "register": {
      "dependsOn": ["build"],
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:smoke": {
      "cache": false
    },
    "db:studio": {
      "cache": false
    },
    "cf-typegen": {
      "cache": false
    },
    "wrangler:deploy": {
      "dependsOn": ["build"],
      "cache": false
    },
    "wrangler:dev": {
      "cache": false,
      "persistent": true
    },
    "wrangler:tail": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    }
  }
}
