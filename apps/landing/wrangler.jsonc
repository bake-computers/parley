{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parley-website",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "workers_dev": false,
  "logpush": true,
  "observability": { "enabled": true },

  "vars": {
    "SERVICE_NAME": "landing",
    "AXIOM_DATASET": "parley",
    "AXIOM_ENABLED": "true",
  },

  "services": [{ "binding": "BRIDGE", "service": "parley-bridge" }],

  "kv_namespaces": [
    {
      "binding": "MATCH_KV",
      "id": "d1811757b1204fd2ab1d0225c7bbb5e3",
      "remote": true,
    },
  ],

  "routes": [{ "pattern": "parley.bot", "custom_domain": true }],
}
