# Copy to .dev.vars (gitignored) for local OAuth.
DISCORD_CLIENT_SECRET=
AUTH_SECRET=
# Same bot token as apps/worker — required for "Ready" vs "Add Parley" on /dashboard.
DISCORD_BOT_TOKEN=

# Engine/dashboard: `bun run dev` uses remote Cloudflare bindings (VPC_SERVICE, MATCH_KV).
# Log in once: wrangler login