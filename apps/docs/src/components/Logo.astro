---
/**
 * The Parley mark — the faceted isometric P, shared with the web app
 * (apps/web/public/parley-logo.svg). Keep the two assets in sync.
 */
interface Props {
  size?: number;
}

const { size = 20 } = Astro.props;
---

<img src="/parley-logo.svg" width={size} height={size} alt="" aria-hidden="true" />
