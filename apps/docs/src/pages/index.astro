---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Logo from "../components/Logo.astro";
import { config } from "virtual:nimbus/config";

const sections = [
  {
    href: "/getting-started",
    title: "Getting started",
    body: "Add Parley, accept the terms, and link your Rainbow Six Siege account in a few minutes.",
  },
  {
    href: "/commands",
    title: "Commands",
    body: "Every slash command, what it does, and what you see back.",
  },
  {
    href: "/ranks-and-stats",
    title: "Ranks and stats",
    body: "The Parley Rank ladder and the stats behind your profile.",
  },
  {
    href: "/matchmaking",
    title: "Matchmaking",
    body: "How teams get balanced and what keeps a lobby fair.",
  },
  {
    href: "/tournaments",
    title: "Tournaments",
    body: "Create a bracket on the website and join one with a code.",
  },
  {
    href: "/privacy-and-data",
    title: "Privacy and data",
    body: "What Parley stores, what you control, and how to delete it.",
  },
];
---

<BaseLayout title={config.title} description={config.description}>
  <div class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-1 mx-auto max-w-3xl w-full px-6 py-20">
      <div class="flex items-center gap-3">
        <Logo size={36} />
        <h1
          class="text-foreground leading-tight"
          style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
        >
          Parley Docs
        </h1>
      </div>
      <p class="mt-3 text-[1.0625rem] text-muted-foreground leading-relaxed max-w-xl">
        Fair, skill-matched Rainbow Six Siege. Parley builds balanced teams
        from real skill and telemetry, then automates scrims and tournaments.
        These guides cover everything you can do with the Discord app.
      </p>

      <div class="mt-10 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {sections.map((section) => (
          <a
            href={section.href}
            class="block rounded-lg border border-border bg-card p-4 transition-colors hover:border-border-strong no-underline"
          >
            <div class="font-medium text-foreground">{section.title}</div>
            <div class="mt-1 text-sm text-muted-foreground leading-relaxed">{section.body}</div>
          </a>
        ))}
      </div>

      <p class="mt-10 text-sm text-muted-foreground">
        Looking for tournaments, legal pages, or your dashboard? Head to
        <a href="https://parley.bot" class="text-foreground underline underline-offset-2">parley.bot</a>.
      </p>
    </main>
  </div>
</BaseLayout>
