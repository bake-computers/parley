{
  "name": "@parley/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Worker REST API for the Parley platform, powered by typed ConnectRPC clients.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --port 8787 --tunnel --tunnel-name parley",
    "dev:local": "wrangler dev --env local --port 8787 --tunnel --tunnel-name parley",
    "typecheck": "tsc --noEmit && wrangler types --check",
    "lint": "oxlint .",
    "test": "bun test src",
    "register-commands": "bun run src/register-commands.ts"
  },
  "dependencies": {
    "@connectrpc/connect": "^2.0.0",
    "@connectrpc/connect-web": "^2.0.0",
    "@parley/axiom": "workspace:*",
    "@parley/proto": "workspace:*",
    "@parley/runtime": "workspace:*",
    "discord-api-types": "^0.38.47",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260506.1",
    "@parley/tsconfig-base": "workspace:*",
    "@types/node": "^25.9.3",
    "neverthrow": "^8.2.0",
    "wrangler": "^4.98.0"
  }
}
