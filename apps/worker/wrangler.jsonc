{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "parley",
  "main": "dist/index.js",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "region": "aws:eu-west-1",
  },
  "build": {
    "command": "bun run build",
    "cwd": "./",
    "watch_dir": [
      "./src",
      "./tests",
      "../../packages/core/src",
      "../../packages/db/src",
      "../../packages/discord-runtime/src",
    ],
  },
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["*/1 * * * *"],
  },
  "logpush": true,
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS_ENGINE",
      "dataset": "parley_analytics",
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d2add657818c4c27a193021181e494b6",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "Cache",
      "id": "61663c82d70c4483bb094c5afbcfd744",
      "remote": true,
    },
  ],
  "queues": {
    "producers": [
      {
        "queue": "parley-stat-refresh",
        "binding": "Queue",
      },
    ],
    "consumers": [
      {
        "queue": "parley-stat-refresh",
        "max_batch_size": 5,
        "max_batch_timeout": 30,
        "max_retries": 3,
      },
    ],
  },
}
