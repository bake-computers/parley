{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "parley",
  "main": "dist/index.js",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "region": "aws:eu-west-1",
  },
  "build": {
    "command": "bun run build",
    "cwd": "./",
    "watch_dir": [
      "./src",
      "./tests",
      "../../packages/core/src",
      "../../packages/db/src",
      "../../packages/discord-runtime/src",
    ],
  },
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["*/1 * * * *"],
  },
  "logpush": true,
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS_ENGINE",
      "dataset": "parley_analytics",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "Queue",
        "queue": "parley-stat-refresh",
      },
    ],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d2add657818c4c27a193021181e494b6",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "Cache",
      "id": "61663c82d70c4483bb094c5afbcfd744",
      "remote": true,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LeaderboardDO",
        "class_name": "LeaderboardDO",
      },
    ],
  },
  "migrations": [
    {
      "new_sqlite_classes": ["LeaderboardDO"],
      "tag": "v1",
    },
  ],
  "routes": [
    {
      "pattern": "app.parley.bot",
      "zone_name": "parley.bot",
      "custom_domain": true,
    },
  ],
  "preview_urls": false,
  "workers_dev": false,
}
