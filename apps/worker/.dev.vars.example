# Copy to .dev.vars (gitignored) for local development.
# Required secrets:
DISCORD_PUBLIC_KEY=your_discord_application_public_key
DISCORD_BOT_TOKEN=your_bot_token_here
# Required by `bun run register-commands` (it reads this from .dev.vars).
# Also set as a wrangler var, so `wrangler dev` works without it.
DISCORD_APPLICATION_ID=your_application_id_here
# Must match the engine and apps/web ENGINE_SHARED_SECRET.
ENGINE_SHARED_SECRET=
# Must match apps/web TOURNAMENT_HANDOFF_SECRET; verifies /tournament create handoffs.
TOURNAMENT_HANDOFF_SECRET=

# Optional:
# DISCORD_BOT_OWNER_ID=optional_user_id
# AXIOM_TOKEN=your_axiom_ingest_token
# AXIOM_DATASET=parley
# AXIOM_ORG_ID=optional_org_id
# AXIOM_EDGE=eu-central-1.aws.edge.axiom.co
