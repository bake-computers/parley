    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "@unpic/react": "^1.0.2",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.1.0",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.8.0",
    "tailwindcss": "^4.1.18",
