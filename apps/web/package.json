{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "CLOUDFLARE_ENV=local vp dev --port 3000 --strictPort",
    "dev:remote": "PARLEY_REMOTE_BINDINGS=1 vp dev --port 3000 --strictPort",
    "build": "vp build",
    "preview": "bun run build && vp preview",
    "test": "vp test run",
    "typecheck": "tsc --noEmit",
    "cache:founders": "bun run scripts/cache-founder-avatars.ts",
    "optimize:assets": "bun run scripts/optimize-assets.ts",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@mdx-js/rollup": "^3.1.1",
    "@parley/discord-components": "workspace:*",
    "@parley/parley-rank": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/charts": "^0.6.5",
    "@tanstack/charts-scales": "^0.7.2",
    "@tanstack/react-charts": "^0.6.5",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.0.8",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.8.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.39.0",
    "@cloudflare/workers-types": "^4.20260506.1",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@webgpu/types": "^0.1.71",
    "jsdom": "^28.1.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.98.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
