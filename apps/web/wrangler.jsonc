{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parley-website",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "cache": {
    "enabled": true,
  },
  "placement": { "mode": "smart" },
  "workers_dev": false,
  "logpush": true,
  "observability": { "enabled": true },

  "vars": {
    "SERVICE_NAME": "web",
    "DISCORD_APPLICATION_ID": "1495122091165618358",
    "ENGINE_INTERNAL_URL": "http://api.internal.parley.bot:50051",
    "TURNSTILE_SITE_KEY": "0x4AAAAAADp6daoSm0g2pBC_",
  },

  "vpc_services": [
    {
      "binding": "VPC_SERVICE",
      "service_id": "019e56b4-32d2-7843-bf2b-ec4b056d4400",
      "remote": true,
    },
  ],

  "routes": [
    { "pattern": "parley.bot", "custom_domain": true },
    { "pattern": "www.parley.bot", "custom_domain": true },
  ],
  "env": {
    "local": {
      "vars": {
        "SERVICE_NAME": "web",
        "DISCORD_APPLICATION_ID": "1495122091165618358",
        "ENGINE_INTERNAL_URL": "http://127.0.0.1:50051",
        "TURNSTILE_SITE_KEY": "0x4AAAAAADp6daoSm0g2pBC_",
      },
    },
    "staging": {
      "routes": [{ "pattern": "staging.parley.bot", "custom_domain": true }],
    },
  },
}
