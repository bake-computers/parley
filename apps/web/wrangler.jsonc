{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parley-website",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "cache": {
    "enabled": true,
  },
  "placement": { "mode": "smart" },
  "workers_dev": false,
  "logpush": true,
  "observability": { "enabled": true },

  // Sample values: replace the Discord application ID, the engine host, the
  // Turnstile key, and the VPC service ID with your own before deploying.
  // The Turnstile value here is Cloudflare's documented always-pass test key.
  "vars": {
    "SERVICE_NAME": "web",
    "DISCORD_APPLICATION_ID": "000000000000000000",
    "ENGINE_INTERNAL_URL": "http://engine.internal.example:50051",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
  },

  // Secret names only, never values. Declaring them replaces .dev.vars/.env
  // inference for `wrangler types`, so generated env types are deterministic in
  // CI, where no local secret files exist. Not inherited by named envs.
  "secrets": {
    "required": [
      "DISCORD_CLIENT_SECRET",
      "AUTH_SECRET",
      "TOURNAMENT_HANDOFF_SECRET",
      "TURNSTILE_SECRET_KEY",
      "DISCORD_BOT_TOKEN",
      "ENGINE_SHARED_SECRET",
    ],
  },

  "vpc_services": [
    {
      "binding": "VPC_SERVICE",
      "service_id": "00000000-0000-0000-0000-000000000000",
      "remote": true,
    },
  ],

  "routes": [
    { "pattern": "parley.bot", "custom_domain": true },
    { "pattern": "www.parley.bot", "custom_domain": true },
  ],
  "env": {
    "local": {
      "vars": {
        "SERVICE_NAME": "web",
        "DISCORD_APPLICATION_ID": "000000000000000000",
        "ENGINE_INTERNAL_URL": "http://127.0.0.1:50051",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
      },
      "secrets": {
        "required": [
          "DISCORD_CLIENT_SECRET",
          "AUTH_SECRET",
          "TOURNAMENT_HANDOFF_SECRET",
          "TURNSTILE_SECRET_KEY",
          "DISCORD_BOT_TOKEN",
          "ENGINE_SHARED_SECRET",
        ],
      },
    },
    "staging": {
      "routes": [{ "pattern": "staging.parley.bot", "custom_domain": true }],
      "secrets": {
        "required": [
          "DISCORD_CLIENT_SECRET",
          "AUTH_SECRET",
          "TOURNAMENT_HANDOFF_SECRET",
          "TURNSTILE_SECRET_KEY",
          "DISCORD_BOT_TOKEN",
          "ENGINE_SHARED_SECRET",
        ],
      },
    },
  },
}
