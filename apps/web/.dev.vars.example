# Copy to .dev.vars (gitignored) for local development.
DISCORD_CLIENT_SECRET=
AUTH_SECRET=
# Must match the secret configured for apps/worker; it verifies /tournament create handoffs.
TOURNAMENT_HANDOFF_SECRET=

# Cloudflare Turnstile — use official test keys locally (always pass on localhost).
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Production: real widget keys via wrangler vars + `wrangler secret put TURNSTILE_SECRET_KEY`
# Same bot token as apps/worker — required for "Ready" vs "Add Parley" on /dashboard.
DISCORD_BOT_TOKEN=

# Required: must match the engine and apps/worker ENGINE_SHARED_SECRET.
# Production: `cd apps/web && npx wrangler secret put ENGINE_SHARED_SECRET`
ENGINE_SHARED_SECRET=

# Local-first: `bun run dev` (CLOUDFLARE_ENV=local) talks to the engine on
# your machine at 127.0.0.1:50051 — set via wrangler env.local in
# wrangler.jsonc; no flag needed. Without env.local the top-level sample config
# keeps the VPC binding and its placeholder ENGINE_INTERNAL_URL → VPC.
# Remote VPC web dev instead: `wrangler login` once, then `bun run dev:remote`
# (PARLEY_REMOTE_BINDINGS=1) — no env.local, so top-level VPC config applies.
# The top-level vars in wrangler.jsonc are sanitized samples; point them at your
# own Discord application, Turnstile widget, and VPC service before deploying.
