{
  "name": "parley",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:worker": "turbo run build --filter=@parley/worker",
    "build:hq": "turbo run build --filter=@parley/hq",
    "build:web": "turbo run build --filter=@parley/web",
    "dev:web": "turbo run dev --filter=@parley/web",
    "deploy:web": "turbo run deploy --filter=@parley/web",
    "cf-typegen:web": "turbo run cf-typegen --filter=@parley/web",
    "dev": "turbo run dev",
    "deploy": "turbo run deploy --filter=@parley/worker",
    "deploy:hq": "turbo run deploy --filter=@parley/hq",
    "register": "turbo run register --filter=@parley/worker",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate --filter=@parley/worker",
    "db:migrate": "turbo run db:migrate --filter=@parley/worker",
    "db:backfill:d1": "turbo run db:backfill:d1 --filter=@parley/worker",
    "db:smoke": "turbo run db:smoke --filter=@parley/worker",
    "db:studio": "turbo run db:studio --filter=@parley/worker",
    "cf-typegen": "turbo run cf-typegen --filter=@parley/worker",
    "cf-typegen:hq": "turbo run cf-typegen --filter=@parley/hq",
    "wrangler:deploy": "turbo run wrangler:deploy --filter=@parley/worker",
    "wrangler:deploy:hq": "turbo run wrangler:deploy --filter=@parley/hq",
    "wrangler:dev": "turbo run wrangler:dev --filter=@parley/worker",
    "wrangler:tail": "turbo run wrangler:tail --filter=@parley/worker",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.6.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "turbo": "^2.9.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.12"
}
