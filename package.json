{
  "name": "@parley/root",
  "version": "0.0.0",
  "private": true,
  "description": "Parley monorepo root",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "vp run -r --cache build",
    "dev": "vp run -r --parallel --no-cache dev",
    "dev:worker": "vp run --filter @parley/worker --no-cache dev",
    "dev:web": "vp run --filter web --no-cache dev",
    "lint": "vp run -r lint",
    "lint:root": "vp lint",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "typecheck": "vp run --filter @parley/runtime --filter @parley/axiom --cache build && vp run -r typecheck",
    "test": "vp run --filter @parley/runtime --filter @parley/axiom --cache build && vp run -r test",
    "deploy": "vp run -r --cache build && vp run -r --no-cache deploy",
    "deploy:worker": "vp run --filter @parley/worker --no-cache deploy",
    "deploy:web": "vp run --filter web --no-cache deploy",
    "deploy:docs": "vp run --filter @parley/docs --no-cache deploy",
    "lint:fix": "vp lint --fix"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.3.14",
    "bun-types": "^1.3.13",
    "typescript": "^7.0.1-rc",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.98.0"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.12",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vitest": "4.1.10",
    "vite-plus": "0.2.6"
  }
}
