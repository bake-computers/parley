{
  "name": "@parley/root",
  "version": "0.0.0",
  "private": true,
  "description": "Parley monorepo root",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:worker": "bun run --filter @parley/worker dev",
    "dev:web": "bun run --filter web dev",
    "dev:docs": "bun run --filter @parley/docs dev",
    "lint": "turbo run lint",
    "lint:root": "oxlint . -c oxlint.config.ts",
    "format": "oxfmt --write . -c oxfmt.config.ts",
    "format:check": "oxfmt --check . -c oxfmt.config.ts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "deploy": "turbo run deploy",
    "deploy:worker": "bun run --filter @parley/worker deploy",
    "deploy:web": "bun run --filter web deploy",
    "deploy:docs": "bun run --filter @parley/docs deploy"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.3.14",
    "bun-types": "^1.3.13",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.63.0",
    "turbo": "^2.10.3",
    "typescript": "^7.0.1-rc",
    "wrangler": "^4.98.0"
  },
  "packageManager": "bun@1.3.12"
}
