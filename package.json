{
  "name": "@parley/root",
  "version": "0.0.0",
  "private": true,
  "description": "Parley monorepo root",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:worker": "bun run --filter @parley/worker dev",
    "dev:bridge": "bun run --filter @parley/bridge dev",
    "dev:landing": "bun run --filter landing dev",
    "lint": "turbo run lint",
    "lint:root": "oxlint . -c oxlint.config.ts",
    "format": "oxfmt --write . -c oxfmt.config.ts",
    "format:check": "oxfmt --check . -c oxfmt.config.ts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "deploy": "turbo run deploy",
    "deploy:worker": "bun run --filter @parley/worker deploy",
    "deploy:bridge": "bun run --filter @parley/bridge deploy",
    "deploy:landing": "bun run --filter landing deploy",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.3.14",
    "bun-types": "^1.3.13",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.63.0",
    "turbo": "^2.9.9",
    "typescript": "^6.0.3",
    "wrangler": "^4.98.0"
  },
  "packageManager": "bun@1.3.12"
}
