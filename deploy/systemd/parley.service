[Unit]
Description=Parley engine-service (ConnectRPC)
After=network-online.target

[Service]
Type=simple
# Remove User=parley and Group=parley so it runs as deployer natively
WorkingDirectory=/home/deployer/apps/parley
EnvironmentFile=/home/deployer/apps/parley/production.env
# Engine → Discord worker notification dispatch. Set NOTIFY_WEBHOOK_SECRET in production.env
# (must match `cd apps/worker && wrangler secret put NOTIFY_WEBHOOK_SECRET`).
Environment=NOTIFY_WEBHOOK_URL=https://app.parley.bot/internal/notifications/dispatch
ExecStart=/home/deployer/apps/parley/current
Restart=always
RestartSec=5

# Remove ProtectSystem=strict since an unprivileged user cannot namespace paths
NoNewPrivileges=true

[Install]
WantedBy=default.target