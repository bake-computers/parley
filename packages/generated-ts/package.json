{
  "name": "@parley/proto",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript types and ConnectRPC clients generated from parley protos.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./common/v1/*": "./src/common/v1/*",
    "./engine/v1/*": "./src/engine/v1/*",
    "./stats/v1/*": "./src/stats/v1/*",
    "./ocr/v1/*": "./src/ocr/v1/*",
    "./guild/v1/*": "./src/guild/v1/*",
    "./identity/v1/*": "./src/identity/v1/*"
  },
  "scripts": {
    "generate": "cd ../.. && buf generate",
    "clean": "rm -rf src/common src/engine src/stats src/ocr src/guild src/identity",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.3",
    "@connectrpc/connect": "^2.0.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.47.2",
    "@bufbuild/protoc-gen-es": "^2.2.3"
  }
}
