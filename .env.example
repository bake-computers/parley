# Engine (Go) — copy to .env and fill in values.
ENGINE_SERVICE_ADDR=0.0.0.0:50051
# Prometheus scrape listener; keep Docker-internal (not published to the host).
METRICS_ADDR=0.0.0.0:9090
# Shared secret authenticating edge callers (worker/web) on every non-probe
# route; must match the worker/web ENGINE_SHARED_SECRET secret.
ENGINE_SHARED_SECRET=change-me-in-production
LOG_LEVEL=info

# Postgres — required
DATABASE_URL=postgres://parley:parley@127.0.0.1:5432/parley
RUN_MIGRATIONS=0
DB_TLS=system

# Optional pool tunables
# DB_POOL_MAX=32
# DB_POOL_MIN_IDLE=0

# stats.cc API (required for live player stats)
# STATS_CC_API_KEY=
# STATS_CC_API_BASE_URL=https://r6.stats.cc
# STATS_CC_PROFILE_BATCH_SIZE=10   # 0 disables batching (direct GET only); max 10
# STATS_CC_PROFILE_BATCH_DELAY_MS=25  # coalescing window ms; clamped 1–2000

# GDPR account-deletion cooldown (required for DeleteUserData RPC)
ACCOUNT_DELETION_HMAC_SECRET=change-me-in-production
# Optional: one Discord user exempt from the re-link cooldown (testing/support).
# Leave empty to disable the bypass.
BOT_OWNER_DISCORD_ID=

# OVI matchmaking model (required by the engine at startup)
# MATCHMAKING_MODEL_R2_ACCOUNT_ID=
# MATCHMAKING_MODEL_R2_ACCESS_KEY_ID=
# MATCHMAKING_MODEL_R2_SECRET_ACCESS_KEY=
# MATCHMAKING_MODEL_R2_BUCKET=ovi
# MATCHMAKING_MODEL_R2_KEY=ovi_model.onnx
# MATCHMAKING_MODEL_R2_JURISDICTION=eu
# Pinned SHA256 of the model artifact in R2; the engine refuses to boot on
# mismatch or when unset. The boot log prints the fetched model's sha256.
MATCHMAKING_MODEL_R2_SHA256=
# MATCHMAKING_MODEL_MIN_SEASON_MATCHES=3
# MATCHMAKING_ROLE_BALANCE_WEIGHT=0.10
# MATCHMAKING_ROLE_COLLISION_WEIGHT=0.05

# Cloudflare Pipelines (engine). Leave unset for local.
# PIPELINES_INGEST_URL=https://<your-pipeline-id>.ingest.cloudflare.com
# PIPELINES_TOKEN=

# Worker secrets (DISCORD_*, ENGINE_SHARED_SECRET) live in apps/worker/.dev.vars
