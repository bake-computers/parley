# -------------------- engine-service runtime (Go) --------------------
# Where the HTTP + ConnectRPC server listens.
ENGINE_SERVICE_ADDR=0.0.0.0:50051

# slog level: debug, info, warn, error (RUST_LOG is accepted as fallback).
LOG_LEVEL=info

# -------------------- Postgres (pgxpool + Bun) --------------------
# REQUIRED for persistence, identity RPCs, and the Postgres-backed stats cache.
# Leave empty to run the service in degraded / in-memory mode (R6 only).
DATABASE_URL=postgres://parley:parley@127.0.0.1:5432/parley

# Pool tunables — all optional.
DB_POOL_MAX=32
DB_POOL_MIN_IDLE=4
DB_CONNECTION_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_S=600

# TLS mode for the Postgres connection. Most managed providers require TLS.
#   system         — OS trust store (default).
#   webpki         — bundled WebPKI roots.
#   accept-invalid — no cert verification (dev / self-signed only).
#   none           — plain connection, no TLS.
DB_TLS=system

# Optional: path to a PEM file with extra CA certs to trust (e.g. your
# private Postgres server's self-signed CA). Combines with DB_TLS=system or
# DB_TLS=webpki. Preferred over DB_TLS=accept-invalid for production.
# DB_TLS_CA_FILE=/etc/parley/pg-ca.pem

# Set to `1` to run embedded SQL migrations on startup (bun/migrate).
RUN_MIGRATIONS=0

# Reserved for queue expiry tuning (sweeper); not yet wired in Go config.
# QUEUE_STALE_THRESHOLD_MS=300000

# HMAC secret for GDPR account-deletion cooldown tracking (required for DeleteUserData RPC).
ACCOUNT_DELETION_HMAC_SECRET=change-me-in-production

# -------------------- Stats cache --------------------
# Default cache window per game (ms).
STATS_TTL_R6_MS=60000
# Extra grace window served when a backend is unavailable (ms).
STATS_STALE_GRACE_MS=86400000

# -------------------- Redis --------------------
# When set, enables Redis-backed stats cache + leaderboard.
# Leave empty to run without a cache store (direct backend calls).
REDIS_URL=redis://127.0.0.1:6379

# -------------------- Axiom (structured logging) --------------------
# Used by engine-service, worker, and bridge. Leave AXIOM_TOKEN empty to disable.
# AXIOM_TOKEN=your_axiom_ingest_token
# AXIOM_DATASET=parley
# AXIOM_ORG_ID=optional_org_id
# Set AXIOM_EDGE when the dataset lives outside US East (match dataset region in Axiom Console).
# US East (default): omit AXIOM_EDGE
# EU Central: AXIOM_EDGE=eu-central-1.aws.edge.axiom.co
# AXIOM_EDGE=eu-central-1.aws.edge.axiom.co
# AXIOM_ENABLED=true

# -------------------- Cloudflare Workers (Wrangler) --------------------
# Deploy auth: `wrangler login` (or set CLOUDFLARE_API_TOKEN for CI).
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# CLOUDFLARE_ACCOUNT_ID=your_account_id
#
# Worker script names are pinned in each app's wrangler.jsonc:
#   apps/worker/wrangler.jsonc   -> "parley-dev"
#   apps/bridge/wrangler.jsonc   -> "leaderboard-bridge"
#   apps/landing/wrangler.jsonc  -> "landing"
#
# Local secrets (DISCORD_*, AXIOM_TOKEN, ...) go in each app's
# `.dev.vars` (gitignored). Production secrets are managed with
# `wrangler secret put <NAME>` (run from the app directory).
# ENGINE_SERVICE_URL=http://localhost:50051
# DISCORD_PUBLIC_KEY=
# DISCORD_BOT_TOKEN=
# DISCORD_APPLICATION_ID=
# DISCORD_BOT_OWNER_ID=
# BRIDGE_ALLOWED_ORIGINS=https://parley.bot,http://localhost:3000,http://127.0.0.1:3000
# BRIDGE_POLL_INTERVAL_MS=60000


