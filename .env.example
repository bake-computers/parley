# Engine (Go) — copy to .env and fill in values.
ENGINE_SERVICE_ADDR=0.0.0.0:50051
LOG_LEVEL=info

# Postgres — required
DATABASE_URL=postgres://parley:parley@127.0.0.1:5432/parley
RUN_MIGRATIONS=0
DB_TLS=system

# Optional pool tunables
# DB_POOL_MAX=32
# DB_POOL_MIN_IDLE=0

# Redis — required (stats cache + leaderboard)
REDIS_URL=redis://127.0.0.1:6379

# stats.cc API (required for live player stats)
# STATS_CC_API_KEY=
# STATS_CC_API_BASE_URL=https://r6.stats.cc
# STATS_CC_PROFILE_BATCH_SIZE=10   # 0 disables batching (direct GET only); max 10
# STATS_CC_PROFILE_BATCH_DELAY_MS=25  # coalescing window ms; clamped 1–2000

# GDPR account-deletion cooldown (required for DeleteUserData RPC)
ACCOUNT_DELETION_HMAC_SECRET=change-me-in-production

# Axiom logging — optional
# AXIOM_TOKEN=
# AXIOM_DATASET=parley
# AXIOM_ORG_ID=
# AXIOM_EDGE=eu-central-1.aws.edge.axiom.co

# Worker secrets (DISCORD_*, ENGINE_SERVICE_URL) live in apps/worker/.env or .dev.vars
