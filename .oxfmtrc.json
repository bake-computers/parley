{
  "quotes": "double",
  "arrowParens": "always",
  "printWidth": 100,
  "trailingComma": "all",
  "semicolons": "always",
  "useTabs": false,
  "indentWidth": 2,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/routeTree.gen.ts"
  ]
}
